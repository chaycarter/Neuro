# W — Chay Carter's Personal Assistant
# Copy to .env and fill in your values

# Required
ANTHROPIC_API_KEY=your_api_key_here

# Chrome remote debugging URL (default: localhost:9222)
CDP_URL=http://localhost:9222

# Optional: Chrome executable path
CHROME_PATH=/usr/bin/google-chrome

# Google Sheets — master connections spreadsheet
# Share your sheet with the service account email from credentials JSON
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=/path/to/service-account-credentials.json

# Identity context (used by W)
OWNER_NAME=Chay Carter
OWNER_LINKEDIN=https://www.linkedin.com/in/chay-carter/
OWNER_EMAIL=chay@cartersciences.com
OWNER_COMPANY=Carter Sciences
OWNER_SUBSTACK=https://theneurotechnewsletter.substack.com
